<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AliBird.Core\AliBird.Core.csproj" />
    <ProjectReference Include="..\AliBird.Infrastructure\AliBird.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Smoke ve performans testleri Program.ServisleriKur'u (internal) cagirabilsin -->
    <InternalsVisibleTo Include="AliBird.SmokeTests" />
    <InternalsVisibleTo Include="AliBird.PerformanceTests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>AliBird</AssemblyName>
    <!-- surum 1.0.0 (log ve kurulumda gorunur) -->
    <Version>1.0.0</Version>
    <!-- exe ikonu. Dosya AliBird.IconGenerator ile uretilir; yoksa build yine calisir. -->
    <ApplicationIcon Condition="Exists('..\..\assets\alibird.ico')">..\..\assets\alibird.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>